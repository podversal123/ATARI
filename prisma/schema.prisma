  zoneId                   String
  detailOfTechnology       String
  farmerGrossCost          Decimal?               @db.Decimal(12, 2)
  farmerGrossReturn        Decimal?               @db.Decimal(12, 2)
  farmerNetReturn          Decimal?               @db.Decimal(12, 2)
  farmerBcRatio            Decimal?               @db.Decimal(6, 2)
  demoGrossCost            Decimal?               @db.Decimal(12, 2)
  demoGrossReturn          Decimal?               @db.Decimal(12, 2)
  demoNetReturn            Decimal?               @db.Decimal(12, 2)
  demoBcRatio              Decimal?               @db.Decimal(6, 2)
  additionalIncome         Decimal?               @db.Decimal(12, 2)

  @@index([zoneId])
  @@index([cfldTechnicalParameterId])
}

/// CFLD dialog tab "Socio-economic Impact Parameters" / report "3.
