  kvkId                     String
  kvk                       Kvk    @relation(fields: [kvkId], references: [id])
  zoneId                    String
  textAdvisories            Int    @default(0)
  textFarmers               Int    @default(0)
  whatsappAdvisories        Int    @default(0)
  whatsappFarmers           Int    @default(0)
  socialMediaAdvisories     Int    @default(0)
  socialMediaFarmers        Int    @default(0)
  weatherBulletinAdvisories Int    @default(0)
  weatherBulletinFarmers    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

// ---------------------------------------------------------------------------
// All Masters -> Other/OFT & FLD/Production Masters - the dropdown-source
// lookup tables that populate every form's Select fields (e.g. an FLD
// record's Category/Sub-category, a Staff record's Discipline). These were
// missing entirely from the schema until this pass - lib/navigation.ts's
// ALL_MASTERS tree confirms the exact real list.
// ---------------------------------------------------------------------------

/// Every single-column "Name" master (Job Type, Pay Level, Season, Equipment
/// Type, NICRA Dignitary Type, ...) shares one shape - one generic table
/// with a type discriminator instead of ~30 near-identical single-column
/// models.
enum MasterListType {
  STAFF_CATEGORY
  JOB_TYPE
  PAY_LEVEL
  PAY_SCALE
  SANCTIONED_POST
  DISCIPLINE
  BANK_ACCOUNT_TYPE
  SEASON
  UNIT
  CROP_TYPE
  IMPORTANT_DAY
  INFRASTRUCTURE_TYPE
  SOIL_WATER_ANALYSIS_TYPE
  EQUIPMENT_TYPE
  ASSET_FUNDING_SOURCE
  NARI_ACTIVITY
  NARI_NUTRITION_GARDEN_TYPE
  NARI_CROP_CATEGORY
  NICRA_CATEGORY
  NICRA_SEED_FODDER_BANK
  NICRA_DIGNITARY_TYPE
  NICRA_PI_CO_PI_TYPE
  IMPACT_SPECIFIC_AREA
  ENTERPRISE_TYPE
  ACCOUNT_TYPE
  PROGRAMME_TYPE
  PPV_FRA_TRAINING_TYPE
  VIP_DIGNITARY
  FLD_ACTIVITY
  ARYA_ENTERPRISE
  TSP_SCSP_TYPE
  TSP_SCSP_ACTIVITY
  NATURAL_FARMING_ACTIVITY
  NATURAL_FARMING_SOIL_PARAMETER
  AGRI_DRONE_DEMONSTRATIONS_ON
  PRODUCT_CATEGORY
  TRAINING_CLIENTELE
  TRAINING_FUNDING_SOURCE
  EXTENSION_ACTIVITY_MASTER
  OTHER_EXTENSION_ACTIVITY_MASTER
  EVENTS_MASTER
  PUBLICATION_ITEM
}

model MasterListItem {
  id     String         @id @default(cuid())
  type   MasterListType
  name   String
  zoneId String
  zone   Zone           @relation(fields: [zoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, type, name])
  @@index([zoneId, type])
}

/// OFT Masters: Subject -> Thematic Area (real 2-level hierarchy).
model OftSubject {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  thematicAreas OftThematicAreaMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model OftThematicAreaMaster {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  subject   OftSubject @relation(fields: [subjectId], references: [id])
  zoneId    String

  @@unique([subjectId, name])
  @@index([zoneId])
}

/// FLD Masters: Sector -> Category -> Sub-category, plus a parallel
/// Sector -> Thematic Area branch - both confirmed as real, separate
/// hierarchies under Sector in lib/navigation.ts's oftFldMasters group.
model FldSector {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  thematicAreas FldThematicAreaMaster[]
  categories    FldCategoryMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model FldThematicAreaMaster {
  id       String    @id @default(cuid())
  name     String
  sectorId String
  sector   FldSector @relation(fields: [sectorId], references: [id])
  zoneId   String

  @@unique([sectorId, name])
  @@index([zoneId])
}

model FldCategoryMaster {
  id       String    @id @default(cuid())
  name     String
  sectorId String
  sector   FldSector @relation(fields: [sectorId], references: [id])
  zoneId   String

  subCategories FldSubCategoryMaster[]

  @@unique([sectorId, name])
  @@index([zoneId])
}

model FldSubCategoryMaster {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   FldCategoryMaster @relation(fields: [categoryId], references: [id])
  zoneId     String

  crops CropMaster[]

  @@unique([categoryId, name])
  @@index([zoneId])
}

/// "Crop Master" under OFT & FLD Masters - name is qualified `CropMaster`
/// (not `Crop`) to stay unambiguous against the many plain `crop String`
/// fields used elsewhere in this schema for free-text crop names.
model CropMaster {
  id               String               @id @default(cuid())
  name             String
  unit             String?
  quantityDataType String?
  quantityRequired Boolean              @default(false)
  subCategoryId    String
  subCategory      FldSubCategoryMaster @relation(fields: [subCategoryId], references: [id])
  zoneId           String

  @@unique([subCategoryId, name])
  @@index([zoneId])
}

/// CFLD Crop Master - season + type + crop name, its own flat list (not
/// nested under the FLD Sector/Category hierarchy above).
model CfldCropMaster {
  id       String @id @default(cuid())
  season   String
  type     String
  cropName String
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

/// Production Masters: Product Category -> Product Type -> Products.
model ProductTypeMaster {
  id           String @id @default(cuid())
  categoryName String
  typeName     String
  zoneId       String
  zone         Zone   @relation(fields: [zoneId], references: [id])

  products ProductMaster[]

  @@unique([zoneId, categoryName, typeName])
  @@index([zoneId])
}

model ProductMaster {
  id                  String            @id @default(cuid())
  name                String
  unit                String?
  quantityDataType    String?
  quantityRequired    Boolean           @default(false)
  productTypeMasterId String
  productTypeMaster   ProductTypeMaster @relation(fields: [productTypeMasterId], references: [id])
  zoneId              String

  @@unique([productTypeMasterId, name])
  @@index([zoneId])
}

model CroppingSystemMaster {
  id       String @id @default(cuid())
  season   String
  cropName String
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

model FarmingSystemMaster {
  id                String @id @default(cuid())
  season            String
  farmingSystemName String
  zoneId            String
  zone              Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

/// NICRA Masters: Category -> Sub-category (its own hierarchy, distinct
/// from the FLD one above).
model NicraCategoryMaster {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  subCategories NicraSubCategoryMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model NicraSubCategoryMaster {
  id         String              @id @default(cuid())
  name       String
  categoryId String
  category   NicraCategoryMaster @relation(fields: [categoryId], references: [id])
  zoneId     String

  @@unique([categoryId, name])
  @@index([zoneId])
}

/// Project Wise Budget Masters: Funding Agency -> Financial Project.
model FundingAgencyMaster {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  financialProjects FinancialProjectMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model FinancialProjectMaster {
  id              String              @id @default(cuid())
  projectName     String
  fundingAgencyId String
  fundingAgency   FundingAgencyMaster @relation(fields: [fundingAgencyId], references: [id])
  zoneId          String

  @@unique([fundingAgencyId, projectName])
  @@index([zoneId])
}

/// Training Master hierarchy: Training Type -> Training Area -> Training
/// Thematic Area (real 3-level hierarchy, confirmed columns in
/// lib/navigation.ts's trainingMaster group).
model TrainingTypeMaster {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  areas TrainingAreaMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model TrainingAreaMaster {
  id             String             @id @default(cuid())
  name           String
  trainingTypeId String
  trainingType   TrainingTypeMaster @relation(fields: [trainingTypeId], references: [id])
  zoneId         String

  thematicAreas TrainingThematicAreaMaster[]

  @@unique([trainingTypeId, name])
  @@index([zoneId])
}

model TrainingThematicAreaMaster {
  id             String             @id @default(cuid())
  name           String
  trainingAreaId String
  trainingArea   TrainingAreaMaster @relation(fields: [trainingAreaId], references: [id])
  zoneId         String

  @@unique([trainingAreaId, name])
  @@index([zoneId])
}

/// Resource Masters: Equipment (name + type label).
model EquipmentMaster {
  id            String @id @default(cuid())
  name          String
  equipmentType String
  zoneId        String
  zone          Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

/// Vehicle/Equipment Present Status masters share this exact 4-column shape
/// (Status Code/Label/Hide in Next Year/Is Active) - one table, kind flag.
enum PresentStatusOptionKind {
  VEHICLE
  EQUIPMENT
}

model PresentStatusOption {
  id             String                  @id @default(cuid())
  kind           PresentStatusOptionKind
  statusCode     String
  statusLabel    String
  hideInNextYear Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  zoneId         String
  zone           Zone                    @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, kind, statusCode])
  @@index([zoneId])
}
