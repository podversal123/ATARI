  id                       String  @id @default(cuid())
  kvkId                    String
  kvk                      Kvk     @relation(fields: [kvkId], references: [id])
  zoneId                   String
  farmersCovered           Int
  advisoriesSent           Int
  messagesCrop             Boolean @default(false)
  messagesLivestock        Boolean @default(false)
  messagesWeather          Boolean @default(false)
  messagesMarketing        Boolean @default(false)
  messagesAwareness        Boolean @default(false)
  messagesOtherEnterprises Boolean @default(false)
  messagesAnyOther         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model DigitalOtherChannel {
