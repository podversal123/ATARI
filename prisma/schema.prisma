// ---------------------------------------------------------------------------
// Form Management -> About KVK
// ---------------------------------------------------------------------------

/// 1.1.B Bank Account Details.
model BankAccount {
  id            String  @id @default(cuid())
  kvkId         String
  kvk           Kvk     @relation(fields: [kvkId], references: [id])
  /// zoneId is denormalized onto every KVK-owned table for one reason only:
  /// every list/report query filters by zone, and duplicating the column here
  /// means that filter never needs a join through Kvk just to enforce isolation.
  zoneId        String
  accountType   String
  accountName   String
  bankName      String
  location      String?
  accountNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.2.A All KVK Staff. Matches lib/navigation.ts's employee-details leaf
/// (Position/Email/Category/Transfer Status were the 2026-08-24 additions,
/// already present here) plus the report's fuller field set (DOB, Discipline).
model Staff {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  sanctionedPost String
  name           String
  dateOfBirth    DateTime?
  discipline     String?
  payScale       String?
  dateOfJoining  DateTime?
  category       String? // SC / ST / OBC / General
  jobType        String? // Permanent / Contractual / ...
  position       String?
  mobile         String?
  email          String?
  photoUrl       String?
  resumeUrl      String?
  allowances     String?
  transferStatus String?

  transfersOut StaffTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.2.B Staff Transferred - "from" and "to" are both real KVKs, so this is a
/// join table between Staff and two Kvk rows, not a plain text field like the
/// UI mock currently has it.
model StaffTransfer {
  id                String   @id @default(cuid())
  staffId           String
  staff             Staff    @relation(fields: [staffId], references: [id])
  fromKvkId         String
  fromKvk           Kvk      @relation("TransferFrom", fields: [fromKvkId], references: [id])
  toKvkId           String
  toKvk             Kvk      @relation("TransferTo", fields: [toKvkId], references: [id])
  /// Isolation is scoped to the *destination* KVK's zone (where the transfer
  /// now shows up), matching how the report itself lists it under one KVK.
  zoneId            String
  transferDate      DateTime
  numberOfTransfers Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([staffId])
  @@index([fromKvkId])
  @@index([toKvkId])
}

/// 1.3.A Infrastructure Details.
model Infrastructure {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  infrastructureName   String
  notYetStarted        Boolean  @default(false)
  completedPlinthLevel Boolean  @default(false)
  completedLintelLevel Boolean  @default(false)
  completedRoofLevel   Boolean  @default(false)
  totallyCompleted     Boolean  @default(false)
  plinthAreaSqM        Decimal? @db.Decimal(10, 2)
  underUse             Boolean  @default(false)
  sourceOfFunding      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.3.B Land Details.
model Land {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  item        String
  description String?
  areaHa      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.3.C Staff Quarters Details - the report's own shape is one summary row
/// per KVK plus a 12-month x N-quarter occupancy grid; modelled as a parent
/// row + one child row per (month, quarter) cell rather than flattening the
/// grid into fixed columns, so it isn't locked to a max quarter count.
model StaffQuarters {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  dateOfCompletion DateTime?
  numberOfQuarters Int       @default(0)
  remark           String?

  occupancy StaffQuarterOccupancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model StaffQuarterOccupancy {
  id              String        @id @default(cuid())
  staffQuartersId String
  staffQuarters   StaffQuarters @relation(fields: [staffQuartersId], references: [id])
  quarterNumber   Int
  month           Int // 1-12
  occupied        Boolean

  @@unique([staffQuartersId, quarterNumber, month])
}

/// 1.4.A/B Vehicles Details + Vehicle Status - kept as two tables since the
/// real report treats "status" (running cost, funding, present condition) as
/// a yearly-updated record against the same physical vehicle, not a fixed
/// attribute of it.
model Vehicle {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  name           String
  registrationNo String
  yearOfPurchase Int
  cost           Decimal @db.Decimal(12, 2)

  statuses VehicleStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model VehicleStatus {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  zoneId        String
  reportingYear Int
  totalRunKmHrs Decimal? @db.Decimal(12, 2)
  presentStatus String? // Working / Repairing / ...
  repairingCost Decimal? @db.Decimal(12, 2)
  fundingSource String?
  fundingAgency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, reportingYear])
  @@index([zoneId])
}

/// 1.5.A/B Equipments Details + Equipment Status - same yearly-status pattern
/// as Vehicles.
model Equipment {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  name           String
  yearOfPurchase Int
  cost           Decimal @db.Decimal(12, 2)

  statuses EquipmentStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model EquipmentStatus {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  zoneId        String
  reportingYear Int
  sourceOfFund  String?
  fundingAgency String?
  presentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentId, reportingYear])
  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// Form Management -> Achievements
//
// Columns below are taken 1:1 from lib/navigation.ts's `achievements` group
// (each leaf re-confirmed live against atariams.org, not from the older
// AMS User Manual). Every table follows the same kvkId + denormalized
// zoneId scoping pattern as the About KVK module above.
// ---------------------------------------------------------------------------

enum TrialStatus {
  ONGOING
  COMPLETED
  /// Real third status (client spec, "Pointers for super admin 24 aug.pdf"): manually set when a KVK transfers an Ongoing OFT/FLD to the next reporting year - the original row stays visible under its real year with this status, a new ONGOING copy is created under reportingYear+1.
  TRANSFERRED
}

/// Technical Achievement Summary is a matrix report (year x section x metric
/// x caste-category), not a flat list - modelled as one fact row per cell
/// rather than guessing a fixed wide-column shape, since the UI component
/// (technical-achievement-summary.tsx) renders an open-ended set of metric
/// rows per section that isn't fully enumerable from the nav tree alone.
model TechnicalAchievementSummaryEntry {
  id            String  @id @default(cuid())
  kvkId         String
  kvk           Kvk     @relation(fields: [kvkId], references: [id])
  zoneId        String
  reportingYear Int
  sectionCode   String // e.g. "oft", "fld", "training", "extension"
  metricCode    String // e.g. "no_of_trials", "no_of_farmers_participated"
  casteCategory String? // e.g. "SC", "ST", "OBC", "General" - null where a metric isn't caste-split
  value         Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kvkId, reportingYear, sectionCode, metricCode, casteCategory])
  @@index([zoneId])
}

/// Enriched to match the real per-record report detail (ATARI AMS Report
/// section "1.2.A KVK Wise OFT Details"), not just the list-view columns -
/// the real add form/report carries far more fields than the table shows.
model Oft {
  id            String @id @default(cuid())
  kvkId         String
  kvk           Kvk    @relation(fields: [kvkId], references: [id])
  zoneId        String
  reportingYear Int

  /// Report groups each OFT under a discipline heading, e.g. "OFT
  /// (Agronomy)", "OFT (Animal Science)", "OFT (Fisheries)", "OFT (Home
  /// Science)", "OFT (Agricultural Extension)".
  discipline                  String
  staff                       String
  thematicArea                String
  trialOnForm                 String
  problemDiagnosed            String?
  sourceOfTechnology          String?
  productionSystem            String?
  performanceIndicators       String?
  finalRecommendation         String?
  constraintsIdentified       String?
  farmersParticipationProcess String?
  quantity                    Decimal?    @db.Decimal(10, 2)
  unit                        String?
  noOfTrialReplicationFarmer  Int?
  startMonth                  DateTime?
  endMonth                    DateTime?
  criticalInput               String?
  costOfOft                   Decimal?    @db.Decimal(12, 2)
  fundingAgency               String?
  resultSummary               String?
  status                      TrialStatus

  technologyOptions OftTechnologyOption[]
  resultRows        OftResultRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId, reportingYear])
}

/// "Details of technologies selected for assessment/refinement" - one row
/// per option (Farmer Practice, TO1, TO2, ...).
