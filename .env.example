# Copy this file to .env.local and fill in real values once the Supabase
# project is provisioned (Phase 2 of the rebuild plan). Never commit
# .env.local or any file with real keys - .gitignore already blocks it.

# Supabase project URL and public anon key - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only (Server Actions/Route Handlers).
# Bypasses Row Level Security, so it must never be prefixed with
# NEXT_PUBLIC_ or referenced from client components.
SUPABASE_SERVICE_ROLE_KEY=
